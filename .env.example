# =============================================================================
# Smart Parking & HSRP Management System - Environment Template (.env.example)
# Copy this file to .env and configure local operational parameters.
# Never commit real credentials, production secret tokens, or camera stream keys.
# =============================================================================

# Application Server Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Security & Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-token

# Video Capture Hardware Configuration
# Windows: 0 (default webcam index) or RTSP stream URI
# Linux / Raspberry Pi: /dev/video0 or CSI camera index 0
CAMERA_DEVICE_INDEX=0
CAMERA_BACKEND=DSHOW
CAMERA_REQUESTED_WIDTH=1280
CAMERA_REQUESTED_HEIGHT=720
CAMERA_REQUESTED_FPS=30
CAMERA_MOCK_FALLBACK=false

# Database Storage
DATABASE_PATH=data/parking_events.sqlite
DATABASE_WAL_MODE=true

# Model & Inference Paths
DETECTION_MODEL_PATH=models/vehicle_detector.onnx
DETECTION_RUNTIME=onnx
DETECTION_CONF_THRESHOLD=0.40
DETECTION_INFERENCE_INTERVAL_MS=66

PLATE_MODEL_PATH=models/plate_detector.onnx
PLATE_CONF_THRESHOLD=0.45

OCR_ENGINE=easyocr
OCR_CONF_THRESHOLD=0.50

# Parking Occupancy & Geometry
CALIBRATION_FILE=data/calibration.json
PARKING_OCCUPANCY_THRESHOLD=0.35
PARKING_SMOOTHING_WINDOW=5
PARKING_HYSTERESIS_CONFIRM=3
PARKING_UNKNOWN_TIMEOUT_SEC=5.0

# Privacy & Compliance
PRIVACY_MASK_PLATES=true
ALLOW_RAW_RETENTION=false
